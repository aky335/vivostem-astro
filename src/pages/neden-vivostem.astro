---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { ayarlar } from '../lib/ayarlar.js';
import { marked } from 'marked';
import { gorunenNedenler, ikiHane } from '../lib/icerik.js';

const nedenler = gorunenNedenler(await getCollection('nedenler'));
const mdCevir = (m) => marked.parse(m ?? '', { async: false }).trim();
---

<Layout
  baslik="Neden Vivostem? | Vivostem Türkiye"
  aciklama="Patentli jel bariyer teknolojisi, kapalı sistem hazırlık, uluslararası sertifikasyon, eğitim desteği ve saha ekibi. Vivostem portföyünü standart PRP kitlerinden ayıran farklar."
>

<section class="sayfa-bas">
  <div class="wrap">
    <p class="izlek"><a href="/">Ana Sayfa</a> &nbsp;/&nbsp; Neden Vivostem?</p>
    <h1>Neden Vivostem?</h1>
    <p>Rejeneratif tıpta sonucu belirleyen, ürünün adı değil hazırlanma biçimidir. Aşağıdaki altı başlık, Vivostem portföyünü standart PRP kitlerinden ayıran teknik ve operasyonel farkları anlatıyor.</p>
  </div>
</section>

<section class="bolum">
  <div class="wrap">
    <div class="neden-icerik">
      <aside class="yan-menu">
        <h4>Başlıklar</h4>
        <ul>
          {nedenler.map((n) => (
            <li><a href={`#${n.id}`} set:html={n.data.baslik} /></li>
          ))}
        </ul>
      </aside>
      <div class="maddeler">

        {nedenler.map((n) => (
          <article class="madde" id={n.id}>
            <span class="madde-no">{ikiHane(n.data.sira)}</span>
            <h2 set:html={n.data.baslik} />
            <Fragment set:html={mdCevir(n.data.detay)} />
            {n.data.notMetin && (
              <div class="olcut">
                <p>{n.data.notVurgu && <><strong set:html={n.data.notVurgu} />{' '}</>}<Fragment set:html={n.data.notMetin} /></p>
              </div>
            )}
          </article>
        ))}
</div>
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <div>
      <h2>Portföyü kliniğinizde değerlendirmek ister misiniz?</h2>
      <p>Branşınıza uygun ürün seçimi ve eğitim planı için ekibimizle görüşün.</p>
    </div>
    <div class="btn-grup">
      <a href="/iletisim" class="btn btn--beyaz">İletişim formu</a>
      <a href={ayarlar.whatsappAdres} target="_blank" rel="noopener" class="btn btn--seffaf"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.9-2-1s-.5-.1-.7.2-.8 1-.9 1.2-.3.2-.6.1a8.2 8.2 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.3-.5s0-.4 0-.5-.7-1.6-.9-2.2-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4A3.3 3.3 0 0 0 5 9.2a5.8 5.8 0 0 0 1.2 3 13 13 0 0 0 5 4.4 16 16 0 0 0 1.7.6 4 4 0 0 0 1.8.1 3 3 0 0 0 2-1.4 2.4 2.4 0 0 0 .2-1.4c-.1-.1-.2-.2-.4-.3zM12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2z"/></svg>WhatsApp'tan yazın</a>
    </div>
  </div>
</section>

</Layout>
