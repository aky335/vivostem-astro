---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import UrunBloklari from '../components/UrunBloklari.astro';
import { ayarlar } from '../lib/ayarlar.js';
import { gorunenUrunler } from '../lib/icerik.js';

// Her ürün için bir sayfa. Adres, dosya adından geliyor:
// src/content/urunler/cellenis-prgf.yaml -> /cellenis-prgf
export async function getStaticPaths() {
  const urunler = gorunenUrunler(await getCollection('urunler'));
  return urunler.map((u) => ({
    params: { urun: u.id },
    props: { urun: u },
  }));
}

const { urun } = Astro.props;
const d = urun.data;

const ilgili = d.ilgiliKartlar;
---

<Layout baslik={d.seoBaslik} aciklama={d.seoAciklama}>

<section class="sayfa-bas">
  <div class="wrap">
    <p class="izlek"><a href="/">Ana Sayfa</a> &nbsp;/&nbsp; <a href="/urunler">Ürünler</a> &nbsp;/&nbsp; <Fragment set:html={d.ad} /></p>
    <h1 set:html={d.ad} />
    <p set:html={d.ozet} />
  </div>
</section>

<section class="bolum">
  <div class="wrap">
    <div class="urun-ust">
      <div class="urun-panel"><img src={d.gorsel} alt={d.gorselAlt}></div>
      <div class="urun-yazi">
        <UrunBloklari bloklar={d.bloklar} />
      </div>
    </div>
  </div>
</section>

{ilgili.length > 0 && (
  <section class="bolum bolum--dar bolum--lila">
    <div class="wrap">
      <div class="bolum-bas"><div class="kural"></div>
        <p class="ustbaslik ustbaslik--mor">Portföyün Diğer Ürünleri</p>
        <h2>İlgili ürünler</h2></div>
      <div class="ilgili-grid">
        {ilgili.map((x) => (
          <a class="ilgili-kart" href={x.adres}><h3 set:html={x.baslik} /><p set:html={x.aciklama} /></a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="cta">
  <div class="wrap">
    <div>
      <h2 set:html={d.ctaBaslik} />
      <p set:html={d.ctaMetin} />
    </div>
    <div class="btn-grup">
      <a href="/iletisim" class="btn btn--beyaz">İletişim formu</a>
      <a href={ayarlar.whatsappAdres} target="_blank" rel="noopener" class="btn btn--seffaf"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.9-2-1s-.5-.1-.7.2-.8 1-.9 1.2-.3.2-.6.1a8.2 8.2 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.3-.5s0-.4 0-.5-.7-1.6-.9-2.2-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4A3.3 3.3 0 0 0 5 9.2a5.8 5.8 0 0 0 1.2 3 13 13 0 0 0 5 4.4 16 16 0 0 0 1.7.6 4 4 0 0 0 1.8.1 3 3 0 0 0 2-1.4 2.4 2.4 0 0 0 .2-1.4c-.1-.1-.2-.2-.4-.3zM12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2z"/></svg>WhatsApp'tan yazın</a>
    </div>
  </div>
</section>

</Layout>
