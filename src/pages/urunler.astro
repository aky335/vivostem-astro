---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { ayarlar } from '../lib/ayarlar.js';
import { gorunenUrunler } from '../lib/icerik.js';
import s from '../content/sayfalar/urunler.json';

const urunler = gorunenUrunler(await getCollection('urunler'));

// Her blok kendi ailesindeki ürünleri kart olarak listeliyor. Bloğun kendi
// ana ürünü (Cellenis, Tropocells PRP gibi) panelde "hariç tutulanlar"
// listesinde durduğu için kart olarak tekrar çıkmıyor.
const bloklar = s.bloklar.map((b) => ({
  ...b,
  kartlar: b.aile
    ? urunler.filter((u) => u.data.aile === b.aile && !(b.haricTutulanlar ?? []).includes(u.id))
    : [],
}));
---

<Layout baslik={s.seoBaslik} aciklama={s.seoAciklama}>

<section class="sayfa-bas">
  <div class="wrap">
    <p class="izlek"><a href="/">Ana Sayfa</a> &nbsp;/&nbsp; Ürünler</p>
    <h1 set:html={s.baslik} />
    <p set:html={s.ozet} />
  </div>
</section>
<section class="bolum"><div class="wrap">
{bloklar.map((b) => (
      <div class="aile">
        <div class="aile-bas">
          <div class="aile-gorsel"><img src={b.gorsel} alt={b.gorselAlt}></div>
          <div>
            <h2 set:html={b.baslik} />
            <p set:html={b.metin} />
            <p style="margin-top:16px"><a class="metin-link" href={b.linkAdres}>{b.linkYazi} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>
          </div>
        </div>
        {b.kartlar.length > 0 && (
        <div class="aile-grid">
        {b.kartlar.map((u) => (
        <a class="ilgili-kart" href={'/' + u.id}><h3 set:html={u.data.ad} /><p set:html={u.data.kartOzeti || u.data.ozet} /></a>
        ))}
        </div>
        )}
      </div>
))}
</div></section>
<section class="cta">
  <div class="wrap">
    <div>
      <h2 set:html={s.ctaBaslik} />
      <p set:html={s.ctaMetin} />
    </div>
    <div class="btn-grup">
      <a href="/iletisim" class="btn btn--beyaz">İletişim formu</a>
      <a href={ayarlar.whatsappAdres} target="_blank" rel="noopener" class="btn btn--seffaf"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.9-2-1s-.5-.1-.7.2-.8 1-.9 1.2-.3.2-.6.1a8.2 8.2 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.3-.5s0-.4 0-.5-.7-1.6-.9-2.2-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4A3.3 3.3 0 0 0 5 9.2a5.8 5.8 0 0 0 1.2 3 13 13 0 0 0 5 4.4 16 16 0 0 0 1.7.6 4 4 0 0 0 1.8.1 3 3 0 0 0 2-1.4 2.4 2.4 0 0 0 .2-1.4c-.1-.1-.2-.2-.4-.3zM12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2z"/></svg>WhatsApp'tan yazın</a>
    </div>
  </div>
</section>

</Layout>
