---
import Layout from '../layouts/Layout.astro';
import { ayarlar } from '../lib/ayarlar.js';
import s from '../content/sayfalar/hakkimizda.json';
---

<Layout baslik={s.seoBaslik} aciklama={s.seoAciklama}>

<section class="sayfa-bas">
  <div class="wrap">
    <p class="izlek"><a href="/">Ana Sayfa</a> &nbsp;/&nbsp; Hakkımızda</p>
    <h1 set:html={s.baslik} />
    <p set:html={s.ozet} />
  </div>
</section>

<section class="bolum">
  <div class="wrap">
    <div class="hakkinda">
      <div>
        <div class="kural"></div>
        <p class="ustbaslik ustbaslik--mor" set:html={s.anaUstBaslik} />
        <h2 set:html={s.anaBaslik} />
        <p class="giris" set:html={s.anaGiris} />
        <p set:html={s.anaMetin} />

        <h3 style="margin-top:38px" set:html={s.portfoyBaslik} />
        <ul class="liste-ok">
          {s.portfoyMaddeler.map((m) => <li set:html={m} />)}
        </ul>

        <h3 style="margin-top:38px" set:html={s.alanlarBaslik} />
        <ul class="alan-liste">
          {s.alanlar.map((a) => <li set:html={a} />)}
        </ul>

        <div class="marka-satiri">
          <span class="marka-etiket" set:html={s.markaEtiket} />
          {s.markalar.map((m) => <img src={m.gorsel} alt={m.alt} class={m.kucuk ? 'kucuk' : undefined}>)}</div>
      </div>

      <aside>
        {s.kutular.map((k, i) => (
        <div class={'kutu' + (k.vurgulu ? ' kutu--lila' : '')} style={i === 0 ? undefined : 'margin-top:20px'}>
          <h3 set:html={k.baslik} />
          <p set:html={k.metin} />
          {k.maddeler.length > 0 && (
          <ul>
            {k.maddeler.map((m) => <li set:html={m} />)}
          </ul>
          )}
          {k.linkYazi && (
          <p style="margin-top:14px"><a class="metin-link" href={k.linkAdres}>{k.linkYazi} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>
          )}
        </div>
        ))}
      </aside>
    </div>
  </div>
</section>

<section class="bolum bolum--lila" id="kurucu">
  <div class="wrap">
    <div class="bolum-bas">
      <div class="kural"></div>
      <p class="ustbaslik ustbaslik--mor" set:html={s.kurucuBolum.ustBaslik} />
      <h2 set:html={s.kurucuBolum.baslik} />
      <p set:html={s.kurucuBolum.metin} />
    </div>
    <div class="hakkinda">
      <div>
        {s.kurucuSol.map((p) => <p set:html={p} />)}
      </div>
      <div>
        {s.kurucuSag.map((p) => <p set:html={p} />)}
        {s.kurucuNot && (
        <div class="olcut">
          <p set:html={s.kurucuNot} />
        </div>
        )}
      </div>
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <div>
      <h2 set:html={s.ctaBaslik} />
      <p set:html={s.ctaMetin} />
    </div>
    <div class="btn-grup">
      <a href="/iletisim" class="btn btn--beyaz">İletişim formu</a>
      <a href={ayarlar.whatsappAdres} target="_blank" rel="noopener" class="btn btn--seffaf"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.9-2-1s-.5-.1-.7.2-.8 1-.9 1.2-.3.2-.6.1a8.2 8.2 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.3-.5s0-.4 0-.5-.7-1.6-.9-2.2-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4A3.3 3.3 0 0 0 5 9.2a5.8 5.8 0 0 0 1.2 3 13 13 0 0 0 5 4.4 16 16 0 0 0 1.7.6 4 4 0 0 0 1.8.1 3 3 0 0 0 2-1.4 2.4 2.4 0 0 0 .2-1.4c-.1-.1-.2-.2-.4-.3zM12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2z"/></svg>WhatsApp'tan yazın</a>
    </div>
  </div>
</section>

</Layout>
