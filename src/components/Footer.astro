---
import { footerUrunler, footerKurumsal } from '../data/menu.js';
import { ayarlar } from '../lib/ayarlar.js';

// Telif yılı otomatik; her ocak ayında elle güncellemek gerekmesin.
const yil = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-ust">
      <div>
        <img src="/assets/img/logo-beyaz.png" alt="Vivostem" class="f-logo">
        <p class="footer-tanit" set:html={ayarlar.footerTanitim} />
        <div class="sosyal">
          <a href={ayarlar.instagramAdres} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
          <a href={ayarlar.linkedinAdres} target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
          <a href={ayarlar.youtubeAdres} target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/></svg></a>
          <a href={ayarlar.whatsappAdres} target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.9-2-1s-.5-.1-.7.2-.8 1-.9 1.2-.3.2-.6.1a8.2 8.2 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.3-.5s0-.4 0-.5-.7-1.6-.9-2.2-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4A3.3 3.3 0 0 0 5 9.2a5.8 5.8 0 0 0 1.2 3 13 13 0 0 0 5 4.4 16 16 0 0 0 1.7.6 4 4 0 0 0 1.8.1 3 3 0 0 0 2-1.4 2.4 2.4 0 0 0 .2-1.4c-.1-.1-.2-.2-.4-.3zM12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2z"/></svg></a>
        </div>
      </div>

      <div>
        <h4>Ürünler</h4>
        <ul>
          {footerUrunler.map((l) => <li><a href={l.href} set:html={l.ad} /></li>)}
        </ul>
      </div>

      <div>
        <h4>Kurumsal</h4>
        <ul>
          {footerKurumsal.map((l) => <li><a href={l.href} set:html={l.ad} /></li>)}
        </ul>
      </div>

      <div>
        <h4>İletişim</h4>
        <ul>
          <li><a href={ayarlar.whatsappAdres} target="_blank" rel="noopener">{ayarlar.telefon}</a></li>
          <li><a href={`mailto:${ayarlar.eposta}`}>{ayarlar.eposta}</a></li>
          <li><a href={ayarlar.instagramAdres} target="_blank" rel="noopener">{ayarlar.instagramKullanici}</a></li>
          <li class="f-adres">{ayarlar.adres}</li>
        </ul>
      </div>
    </div>

    <div class="footer-uyari">{ayarlar.footerUyari}</div>

    <div class="footer-alt">
      <span>&copy; {yil} {ayarlar.telifSahibi}. Tüm hakları saklıdır.</span>
      <span><a href="/kvkk">KVKK Aydınlatma Metni</a> &nbsp;&middot;&nbsp; <a href="/gizlilik">Gizlilik Politikası</a></span>
    </div>
  </div>
</footer>
