---
import Markdoc from '@markdoc/markdoc';
import Layout from '../layouts/Layout.astro';
import { ayarlar } from '../lib/ayarlar.js';
import { yerTutuculariDoldur } from '../lib/icerik.js';

// KVKK ve gizlilik gibi tek metinli sayfalar için ortak iskelet.
//
// Gövde panelde zengin metin editörüyle yazılıyor ve dosyaya Markdoc olarak
// düşüyor. Burada Markdoc'u HTML'e çevirip {{adres}} gibi yer tutucuları
// dolduruyoruz. Astro'nun hazır <Content /> bileşeni yerine elle çevirmemizin
// sebebi bu: yer tutucuları ancak metin HTML'e döndükten sonra
// değiştirebiliyoruz.
const { kayit } = Astro.props;
const sayfa = kayit.data;

// Markdoc, bağlantı adreslerindeki süslü parantezleri adres kodlamasına
// çeviriyor: mailto:{{eposta}} -> mailto:%7B%7Beposta%7D%7D. Yer tutucuyu
// dolduramadan önce bunu geri almamız gerekiyor.
const doldur = (m) =>
  yerTutuculariDoldur(String(m ?? '').replace(/%7B%7B/gi, '{{').replace(/%7D%7D/gi, '}}'), ayarlar);
const kacir = (m) => String(m ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

let govde = Markdoc.renderers
  .html(Markdoc.transform(Markdoc.parse(kayit.body ?? '')))
  // Markdoc çıktıyı <article> ile sarmalıyor, sayfa düzenimizde gereksiz.
  .replace(/^<article>/, '')
  .replace(/<\/article>$/, '');

// Firma künyesi panelde ayrı bir alan; metnin ilk paragrafından hemen sonra,
// yani "Veri sorumlusu" bölümünün altında görünüyor.
const kunye = (sayfa.kunye ?? []).filter((s) => s.etiket || s.deger);
if (kunye.length > 0) {
  const satirlar = kunye
    .map((s) => {
      const deger = kacir(s.deger);
      const adres = kacir(s.adres);
      const dis = s.adres.startsWith('http') || s.adres.startsWith('{{whatsapp');
      const govdeHtml = adres
        ? `<a href="${adres}"${dis ? ' target="_blank" rel="noopener"' : ''}>${deger}</a>`
        : deger;
      return `<li><span>${kacir(s.etiket)}</span>${govdeHtml}</li>`;
    })
    .join('');
  const blok = `<ul class="kunye kunye--genis">${satirlar}</ul>`;
  const kes = govde.indexOf('</p>');
  govde = kes === -1 ? govde + blok : govde.slice(0, kes + 4) + blok + govde.slice(kes + 4);
}

const baslik = doldur(sayfa.baslik);
const ozet = doldur(sayfa.ozet);
const izlek = doldur(sayfa.izlek || sayfa.baslik);
---

<Layout baslik={sayfa.seoBaslik} aciklama={sayfa.seoAciklama}>

<section class="sayfa-bas">
  <div class="wrap">
    <p class="izlek"><a href="/">Ana Sayfa</a> &nbsp;/&nbsp; <Fragment set:html={izlek} /></p>
    <h1 set:html={baslik} />
    <p set:html={ozet} />
  </div>
</section>

<section class="bolum">
  <div class="wrap" style="max-width:820px">
    <div class="hukuki-govde"><Fragment set:html={doldur(govde)} /></div>

    {sayfa.sonGuncelleme && (
      <div class="olcut"><p><strong>Son güncelleme:</strong> {sayfa.sonGuncelleme}</p></div>
    )}
  </div>
</section>

</Layout>
